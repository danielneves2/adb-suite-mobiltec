# Copie para .env.local (nunca vai pro Git). Sem valores reais aqui.

# Só da API (server/ e scripts de migração). NUNCA no app desktop: não tem o prefixo VITE_, então o Vite não embute.
DATABASE_URL=

# Usado só pelo CLI da Vercel neste PC.
VERCEL_TOKEN=

# Embutidos no app desktop no build (obrigatórios pro scripts/publicar-versao.mjs):
# endereço da API na Vercel e a mesma chave cadastrada como APP_KEY lá.
VITE_API_URL=
VITE_APP_KEY=
